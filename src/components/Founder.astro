---
import { Image } from 'astro:assets';
import miguel from '../assets/miguel-cutout.png';
import { ui } from '../i18n/ui';
import type { Lang } from '../data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].about;
---

<section class="section founder" id="about" aria-labelledby="about-title">
  <div class="wrap grid">
    <figure class="portrait">
      <div class="stage" aria-hidden="true"></div>
      <Image src={miguel} alt={t.photoAlt} widths={[420, 640, 817]} sizes="(max-width: 860px) 90vw, 460px" class="photo" />
      <figcaption class="plate glass">
        <span class="name">{t.name}</span>
        <span class="role">{t.role}</span>
      </figcaption>
    </figure>

    <div class="copy">
      <h2 id="about-title">{t.title}</h2>
      <p class="lead">{t.p1}</p>
      <p>{t.p2}</p>

      <dl class="values">
        {
          t.values.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .founder {
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 2rem + 4vw, 6rem);
    align-items: center;
  }
  .portrait {
    position: relative;
    margin: 0;
    max-width: 460px;
    justify-self: center;
    width: 100%;
  }
  /* a soft floor shadow grounds the cut-out portrait; no halo */
  .stage {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 3%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.7), transparent);
    filter: blur(10px);
    transform: translateY(18%);
  }
  .photo {
    position: relative;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 98%);
    mask-image: linear-gradient(180deg, #000 72%, transparent 98%);
  }
  .plate {
    position: absolute;
    left: 50%;
    bottom: 6%;
    transform: translateX(-50%);
    display: grid;
    gap: 0.2rem;
    width: max-content;
    max-width: 92%;
    padding: 0.9rem 1.4rem;
    border-radius: 18px;
    text-align: center;
  }
  .name {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 480;
    font-size: 1.0625rem;
  }
  .role {
    color: var(--gold-ink);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  h2 {
    font-size: var(--step-3);
  }
  .copy p {
    margin-top: 1.25rem;
    color: var(--ash);
    max-width: 58ch;
    line-height: 1.65;
  }
  .copy .lead {
    margin-top: 1.75rem;
    color: var(--ivory);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--line);
  }
  .values div {
    padding: 1.25rem 1.25rem 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .values div:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .values div:nth-child(even) {
    padding-left: 1.25rem;
  }
  dt {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 480;
    font-size: 1.125rem;
  }
  dd {
    margin: 0.4rem 0 0;
    color: var(--ash);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 380px;
    }
  }
  @media (max-width: 420px) {
    .values {
      grid-template-columns: 1fr;
    }
    .values div:nth-child(odd) {
      border-right: 0;
    }
    .values div:nth-child(even) {
      padding-left: 0;
    }
  }
</style>
