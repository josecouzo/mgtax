---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Audiences from './Audiences.astro';
import Process from './Process.astro';
import Founder from './Founder.astro';
import Booking from './Booking.astro';
import Calculator from './Calculator.astro';
import Community from './Community.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import { site } from '../data/site';
import type { Lang } from '../data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: site.name,
  url: Astro.site?.toString(),
  telephone: '+15026797027',
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Louisville', addressRegion: 'KY', addressCountry: 'US' },
  areaServed: 'Louisville, KY',
  availableLanguage: ['es', 'en'],
  sameAs: Object.values(site.social),
};
---

<Base lang={lang} alternate={lang === 'es' ? '/en/' : '/'}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Hero lang={lang} />
  <Services lang={lang} />
  <Audiences lang={lang} />
  <Process lang={lang} />
  <Founder lang={lang} />
  <Booking lang={lang} />
  <Calculator lang={lang} />
  <Community lang={lang} />
  <Faq lang={lang} />
  <Contact lang={lang} />
</Base>
