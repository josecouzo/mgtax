---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import type { Lang, ServiceId } from '../data/services';

interface Props {
  lang: Lang;
  service: ServiceId;
  items: string[];
  title?: string;
  /** Storage key suffix: the home list (short) and service page list (full) are tracked separately. */
  variant: 'short' | 'full';
  idPrefix: string;
}
const { lang, service, items, title, variant, idPrefix } = Astro.props;
const t = ui[lang].booking;
---

<div class="checklist glass" data-checklist={`${service}-${variant}`} data-total={items.length}>
  <div class="head">
    <p class="title">{title ?? t.docsTitle}</p>
    <button class="reset" type="button" data-reset hidden>
      <Icon name="rotate-ccw" size={15} />
      <span>{t.reset}</span>
    </button>
  </div>

  <div class="progress" aria-hidden="true"><span data-bar></span></div>
  <p class="count" aria-live="polite" data-count data-done={t.done}>
    {t.progress(0, items.length)}
  </p>

  <ul role="list">
    {
      items.map((item, i) => (
        <li>
          <label for={`${idPrefix}-${i}`}>
            <input type="checkbox" id={`${idPrefix}-${i}`} value={i} />
            <span class="box" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M5 12.5l4.2 4.2L19 7.5" />
              </svg>
            </span>
            <span class="text">{item}</span>
          </label>
        </li>
      ))
    }
  </ul>
</div>

<script define:vars={{ lang }}>
  // Hydrate each checklist once; progress persists per service+variant in localStorage.
  const fmt = (n, total) => (lang === 'es' ? `${n} de ${total} listos` : `${n} of ${total} ready`);
  document.querySelectorAll('[data-checklist]:not([data-ready])').forEach((root) => {
    root.setAttribute('data-ready', '');
    const key = `mg-docs-${root.dataset.checklist}`;
    const total = Number(root.dataset.total);
    const boxes = [...root.querySelectorAll('input[type=checkbox]')];
    const bar = root.querySelector('[data-bar]');
    const count = root.querySelector('[data-count]');
    const reset = root.querySelector('[data-reset]');

    let saved = [];
    try {
      saved = JSON.parse(localStorage.getItem(key) || '[]');
    } catch {}
    boxes.forEach((b) => (b.checked = saved.includes(Number(b.value))));

    const render = () => {
      const done = boxes.filter((b) => b.checked).map((b) => Number(b.value));
      bar.style.transform = `scaleX(${done.length / total})`;
      const complete = done.length === total;
      count.textContent = complete ? count.dataset.done : fmt(done.length, total);
      root.toggleAttribute('data-complete', complete);
      reset.hidden = done.length === 0;
      try {
        localStorage.setItem(key, JSON.stringify(done));
      } catch {}
    };
    root.addEventListener('change', render);
    reset.addEventListener('click', () => {
      boxes.forEach((b) => (b.checked = false));
      render();
    });
    render();
  });
</script>

<style>
  .checklist {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: 22px;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .title {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 480;
    font-size: 1.125rem;
  }
  .reset {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 36px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(237 237 243 / 0.07);
    color: var(--ash);
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .reset:hover {
    color: var(--ivory);
  }
  .reset[hidden] {
    display: none;
  }
  .progress {
    height: 3px;
    margin-top: 1.1rem;
    border-radius: 3px;
    background: rgb(237 237 243 / 0.1);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--gold), var(--gold-hi));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.6s var(--ease-out);
  }
  .count {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.4s var(--ease-out);
  }
  [data-complete] .count {
    color: var(--gold-ink);
  }
  ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  label {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.8rem 0.25rem;
    min-height: 48px;
    cursor: pointer;
    line-height: 1.45;
  }
  input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .box {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: -1px;
    border-radius: 7px;
    border: 1.5px solid var(--line-strong);
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .box svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--on-gold);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .box path {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: stroke-dashoffset 0.4s var(--ease-out) 0.05s;
  }
  input:checked + .box {
    background: var(--gold);
    border-color: var(--gold);
  }
  input:checked + .box path {
    stroke-dashoffset: 0;
  }
  input:focus-visible + .box {
    outline: 2px solid var(--gold-hi);
    outline-offset: 3px;
  }
  label:hover .box {
    border-color: var(--gold);
  }
  .text {
    color: var(--ivory);
    font-size: 0.9375rem;
    transition: color 0.3s var(--ease-out);
  }
  input:checked ~ .text {
    color: var(--muted);
  }
</style>
