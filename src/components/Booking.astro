---
import Icon from './Icon.astro';
import DocChecklist from './DocChecklist.astro';
import { ui } from '../i18n/ui';
import { href } from '../data/site';
import { services, serviceHref, type Lang } from '../data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].booking;
---

<section class="section booking" id="book" aria-labelledby="book-title">
  <div class="ambient" style="--glow-gold-top: 40%; --glow-gold-left: 45%; --glow-blue-top: -5%; --glow-blue-right: 55%;" aria-hidden="true"></div>
  <div class="wrap inner">
    <header class="section-head center">
      <h2 id="book-title">{t.title}</h2>
      <p>{t.sub}</p>
    </header>

    <div class="tabs" role="tablist" aria-label={t.title} data-tabs>
      {
        services.map((s, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-service={s.id}
          >
            <Icon name={s.icon} size={18} />
            <span>{s[lang].tab}</span>
          </button>
        ))
      }
    </div>

    {
      services.map((s, i) => (
        <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0} data-panel={s.id}>
          <div class="info card">
            <h3>{s[lang].name}</h3>
            <p>{s[lang].booking}</p>
            <p class="free">
              <Icon name="clock" size={16} />
              {t.free}
            </p>
            <div class="info-actions">
              <a class="btn btn-gold" href={s.calendar} target="_blank" rel="noopener">
                <Icon name="calendar-check" size={18} />
                {s[lang].cta}
              </a>
              <a class="full" href={href(serviceHref(s, lang))}>
                {t.full}
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>
          <DocChecklist lang={lang} service={s.id} items={s[lang].docsShort} variant="short" idPrefix={`bk-${s.id}`} />
        </div>
      ))
    }

    <p class="note">{t.note}</p>
  </div>
</section>

<script>
  const tablist = document.querySelector<HTMLElement>('[data-tabs]');
  const tabs = [...(tablist?.querySelectorAll<HTMLButtonElement>('[role=tab]') ?? [])];

  const select = (id: string, focus = false) => {
    tabs.forEach((tab) => {
      const on = tab.dataset.service === id;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && focus) tab.focus();
    });
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab.dataset.service!));
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = tabs[(i + dir + tabs.length) % tabs.length];
      select(next.dataset.service!, true);
    });
  });

  // Keep the booking tabs in step with the hero console and the audience panels.
  window.addEventListener('mg:service', (e) => select((e as CustomEvent<string>).detail));
  document.querySelectorAll<HTMLElement>('[data-pick-service]').forEach((a) =>
    a.addEventListener('click', () => select(a.dataset.pickService!)),
  );
</script>

<style>
  .booking {
    overflow: hidden;
  }
  .inner {
    position: relative;
    z-index: 1;
  }
  .tabs {
    display: flex;
    justify-content: center;
    gap: 4px;
    width: max-content;
    max-width: 100%;
    margin: 0 auto 2rem;
    padding: 5px;
    border-radius: var(--radius-pill);
    background: var(--graphite);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0 1.2rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ash);
    font-weight: 500;
    font-size: 0.9375rem;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }
  .tab:hover {
    color: var(--ivory);
  }
  .tab[aria-selected='true'] {
    background: var(--obsidian);
    color: var(--ivory);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .tab[aria-selected='true'] :global(.icon) {
    color: var(--gold-ink);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 1rem;
    max-width: 62rem;
    margin-inline: auto;
    animation: panel-in 0.5s var(--ease-out);
  }
  .panel[hidden] {
    display: none;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .info {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
  }
  .info h3 {
    font-size: var(--step-2);
  }
  .info p {
    margin-top: 1rem;
    color: var(--ash);
    line-height: 1.6;
  }
  .info .free {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    color: var(--gold-ink);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .info-actions {
    margin-top: auto;
    padding-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .full {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--ash);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .full:hover {
    color: var(--ivory);
  }
  .note {
    margin-top: 1.75rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
    .tabs {
      justify-content: flex-start;
    }
  }
  @media (max-width: 520px) {
    .tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      border-radius: 20px;
    }
    .tab {
      justify-content: center;
      border-radius: 15px;
      padding: 0 0.75rem;
    }
    .info-actions .btn {
      width: 100%;
      white-space: normal;
      text-align: center;
      line-height: 1.2;
      padding-block: 0.75rem;
    }
  }
</style>
